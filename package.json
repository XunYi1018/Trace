{
  "name": "dsh-purge",
  "version": "1.1.84-local.1",
  "description": "DeepSeek Harness (dsh) 提示词注入、深度破甲、全协议兼容与红队演练台维护版",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "!lib/default-prompt-inject.md.bak",
    "!lib/default-prompt-inject.zh.md",
    "!lib/default-prompt-inject.en.md",
    "bin",
    "docs",
    "!docs/agents",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "cordis.legacy-redteam.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test scripts/test-audit-upgrades.mjs scripts/test-maintenance-regression.mjs"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "red-team",
    "pi-ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XunYi1018/Trace.git"
  },
  "homepage": "https://github.com/XunYi1018/Trace#readme",
  "bugs": {
    "url": "https://github.com/XunYi1018/Trace/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/XunYi1018/Trace/archive/refs/heads/main.tar.gz",
      "zip": "https://github.com/XunYi1018/Trace/archive/refs/heads/main.zip",
      "git": "https://github.com/XunYi1018/Trace.git"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.0-rc.2 / 0.2.1-rc.2 / 0.2.2-rc.3",
  "dependencies": {
    "proxy-agent": "^6.5.0",
    "yaml": "^2.9.1"
  }
}
